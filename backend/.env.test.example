# Copy to .env.test.local (git ignored). Use a separate empty test database.
DATABASE_URL=postgresql://TEST_ROLE:TEST_PASSWORD@TEST_HOST/carelink_hardening_test?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://TEST_ROLE:TEST_PASSWORD@TEST_HOST/carelink_hardening_test?sslmode=require
CARELINK_TEST_DATABASE_NAME=carelink_hardening_test
# Gemini key defaults to backend/.env; network benchmark is mandatory.
GEMINI_MODEL=gemini-3.5-flash-lite
