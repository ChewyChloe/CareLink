# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/carelink?schema=public"

# LINE Interaction Layer Configuration
LINE_CHANNEL_SECRET="your_line_channel_secret"
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token"
LINE_PROVIDER_ID="your_line_provider_id"
LINE_MESSAGING_CHANNEL_ID="your_line_messaging_channel_id"
LINE_MINI_APP_CHANNEL_ID="your_line_mini_app_channel_id"

# Security & Sessions
SESSION_SECRET="carelink_dev_session_secret_1234567890_min_32_characters"
MESSAGE_ENCRYPTION_KEY="your_32_byte_hex_encryption_key_placeholder"

# Frontend Origin
FRONTEND_URL="http://localhost:5173"

# AI Extraction (Gemini)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash"

# Care-to-Commerce Supply Reminder
COMMERCE_DIAPER_URL=
